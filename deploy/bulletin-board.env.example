# Copy these settings into /etc/bulletin-board.env on EC2; never commit secrets.
APP_HOST=bulletin.example.edu
APP_PROTOCOL=https
MAIL_FROM=universitybulletinboard@gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=universitybulletinboard@gmail.com
SMTP_PASSWORD=replace-with-google-app-password
# Keep the SECRET_KEY_BASE generated by setup-ec2.sh.
