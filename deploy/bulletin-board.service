[Unit]
Description=University Bulletin Board
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/university-bulletin-board
Environment=RAILS_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SOLID_QUEUE_IN_PUMA=true
EnvironmentFile=/etc/bulletin-board.env
ExecStartPre=/usr/local/bin/ruby deploy/validate-env.rb
ExecStart=/usr/local/bin/bundle exec rails server -b 127.0.0.1 -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=90
UMask=0077

[Install]
WantedBy=multi-user.target
