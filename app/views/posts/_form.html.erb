<% if post.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <ul class="mb-0">
      <% post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: post do |form| %>
  <%= form.label :title %>
  <%= form.text_field :title, required: true, maxlength: 150 %>
  <%= form.label :description %>
  <%= form.text_area :description, required: true, maxlength: 10000, rows: 8 %>
  <%= form.label :category %>
  <%= form.select :category, Post::CATEGORIES, { prompt: "Choose a category" }, required: true %>
  <% if post.persisted? && @existing_image %>
    <div class="mt-3">
      <%= image_tag @existing_image, alt: "Current post image", class: "post-edit-image" %>
      <div class="form-check mt-2">
        <%= check_box_tag "post[remove_image]", "1", params.dig(:post, :remove_image) == "1", class: "form-check-input" %>
        <%= label_tag "post_remove_image", "Remove current image", class: "form-check-label" %>
      </div>
    </div>
  <% end %>
  <%= form.label :image, post.persisted? ? "Replace image (optional)" : "Image (optional)" %>
  <%= form.file_field :image, accept: Post::IMAGE_TYPES.join(","), aria: { describedby: "image-help" } %>
  <p id="image-help" class="form-text">JPG, PNG, or WebP. Maximum 5 MB.<% if post.persisted? %> Leave blank to keep the current image. A replacement takes priority over removal.<% end %></p>
  <% if post.image.attached? && post.errors.any? && !post.image.blob.persisted? %>
    <p class="form-text">Choose your image again before submitting.</p>
  <% end %>
  <%= form.submit post.persisted? ? "Save changes" : "Create post", class: "btn btn-primary" %>
  <%= link_to "Cancel", post.persisted? ? post_path(post) : posts_path, class: "btn btn-outline-secondary mt-3" %>
<% end %>
