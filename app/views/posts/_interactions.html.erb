<div class="post-management" aria-label="Post actions">
  <span class="like-count"><%= pluralize(@post.likes.count, "like") %></span>
  <% if current_user %>
    <% liked = current_user.likes.exists?(post_id: @post.id) %>
    <%= button_to(liked ? "Unlike" : "Like", post_like_path(@post), method: liked ? :delete : :post, class: "btn btn-outline-primary") %>
    <% saved = current_user.saved_posts.exists?(post_id: @post.id) %>
    <%= button_to(saved ? "Unsave" : "Save post", post_saved_post_path(@post), method: saved ? :delete : :post, class: "btn btn-outline-primary") %>
  <% else %>
    <%= link_to "Log in to like or save", login_path %>
  <% end %>
</div>
<section id="comments" class="post-content">
  <h2 class="h4">Comments</h2>
  <% comments = @post.comments.includes(:user).order(created_at: :asc, id: :asc).to_a.reject(&:new_record?) %>
  <% if comments.empty? %><p>No comments yet.</p><% end %>
  <% comments.each do |comment| %>
    <article class="comment border-bottom py-3">
      <strong><%= comment.user.name %></strong>
      <time datetime="<%= comment.created_at.iso8601 %>" class="text-secondary"><%= comment.created_at.strftime("%b %-d, %Y at %H:%M") %></time>
      <div class="comment-body"><%= simple_format(h(comment.body)) %></div>
    </article>
  <% end %>
  <% if current_user %>
    <%= form_with model: [@post, @comment || Comment.new], class: "mt-3" do |form| %>
      <% if @comment&.errors&.any? %>
        <div class="alert alert-danger" role="alert">
          <% @comment.errors.full_messages.each do |message| %><p class="mb-0"><%= message %></p><% end %>
        </div>
      <% end %>
      <%= form.label :body, "Add a comment", class: "form-label" %>
      <%= form.text_area :body, required: true, maxlength: 2000, rows: 3, class: "form-control" %>
      <%= form.submit "Post comment", class: "btn btn-primary mt-2" %>
    <% end %>
  <% else %>
    <%= link_to "Log in to comment", login_path %>
  <% end %>
</section>
