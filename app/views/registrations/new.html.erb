<% content_for :title, "Sign up | University Bulletin Board" %>
<section class="auth-panel">
  <h1>Create account</h1>
  <% if @user.errors.any? %>
    <div class="alert alert-danger" role="alert">
      <ul class="mb-0"><% @user.errors.each do |error| %><li><%= error.attribute == :email && error.type == :invalid ? error.message : error.full_message %></li><% end %></ul>
    </div>
  <% end %>
  <%= form_with model: @user, url: signup_path do |form| %>
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 100, autocomplete: "name" %>
    <%= form.label :email, "University email" %>
    <%= form.email_field :email, required: true, autocomplete: "email" %>
    <%= form.label :password, "Password (at least 12 characters)" %>
    <%= form.password_field :password, required: true, minlength: 12, maxlength: 72, autocomplete: "new-password" %>
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    <%= form.submit "Create account", class: "btn btn-primary" %>
  <% end %>
  <p class="mt-3">Already registered? <%= link_to "Log in", login_path %></p>
</section>
