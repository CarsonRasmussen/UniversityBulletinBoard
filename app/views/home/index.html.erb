<% content_for :title, "Home | University Bulletin Board" %>

<section class="welcome-section">
  <div>
    <h1>What's happening on campus?</h1>
    <p class="welcome-description">
      Discover events, share updates, and stay connected.
    </p>
  </div>

  <%= link_to "Create post", new_post_path, class: "create-button" %>
</section>

<%= render "posts/discovery" %>

<section aria-labelledby="popular-heading">
  <div class="posts-heading mb-4">
    <h2 id="popular-heading">Popular on campus</h2>
    <%= link_to "View all posts →", posts_path, class: "view-all" %>
  </div>

  <%= render "posts/list", posts: @posts %>
</section>
