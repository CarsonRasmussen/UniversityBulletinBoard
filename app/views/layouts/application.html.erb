<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "University Bulletin Board" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="board-container header-content" aria-label="Main navigation">
        <%= link_to root_path, class: "site-brand" do %>
          <span class="u-logo">U</span>
          <span>University Bulletin Board</span>
        <% end %>

        <div class="site-navigation">
          <%= link_to "Home", root_path,
                      class: "navigation-link #{'active' if controller_name == 'home'}",
                      aria: { current: ("page" if controller_name == "home") } %>

          <%= link_to "Posts", posts_path, class: "navigation-link #{'active' if controller_name == 'posts' && action_name != 'new' && action_name != 'create'}" %>
          <%= link_to "Search", posts_path(anchor: "q"), class: "navigation-link" %>
          <%= link_to "Create Post", new_post_path, class: "navigation-link #{'active' if controller_name == 'posts' && %w[new create].include?(action_name)}" %>

          <% if current_user %>
            <%= link_to "Saved", saved_posts_path, class: "navigation-link" %>
            <%= link_to "Liked", liked_posts_path, class: "navigation-link" %>
            <span class="navigation-link"><%= current_user.name %></span>
            <%= button_to "Log out", logout_path, method: :delete, class: "navigation-link" %>
          <% else %>
            <%= link_to "Log in", login_path, class: "navigation-link" %>
            <%= link_to "Sign up", signup_path, class: "navigation-link" %>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="board-container page-content">
      <% flash.each do |type, message| %>
        <div class="alert <%= type == "alert" ? "alert-danger" : "alert-success" %>" role="alert"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="board-container footer-content">
        <%= link_to root_path, class: "footer-brand" do %>
          <span class="u-logo small-logo">U</span>
          <span>University Bulletin Board</span>
        <% end %>

      </div>
    </footer>
  </body>
</html>
