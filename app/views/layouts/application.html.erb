<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "University Bulletin Board" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="board-container header-content" aria-label="Main navigation">
        <%= link_to root_path, class: "site-brand" do %>
          <span class="u-logo">U</span>
          <span>University Bulletin Board</span>
        <% end %>

        <div class="site-navigation">
          <%= link_to "Home", root_path,
                      class: "navigation-link active",
                      aria: { current: "page" } %>

          <button class="navigation-link" disabled>Posts</button>
          <button class="navigation-link" disabled>Search</button>
          <button class="navigation-link" disabled>Create Post</button>

          <span class="guest-avatar" title="Not signed in">U</span>
        </div>
      </nav>
    </header>

    <main class="board-container page-content">
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="board-container footer-content">
        <%= link_to root_path, class: "footer-brand" do %>
          <span class="u-logo small-logo">U</span>
          <span>University Bulletin Board</span>
        <% end %>

      </div>
    </footer>
  </body>
</html>